---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Experience from '../components/Experience.astro';
import NowPlaying from '../components/NowPlaying.astro';
import GitHubActivity from '../components/GitHubActivity.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

// Stable, URL-safe id for a community, derived from its name. Used so the
// gallery can deep-link straight to a community's modal (/#community-<slug>).
const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// Load projects, drop drafts, newest first.
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Homepage shows a selection; the full, filterable list lives on /work.
const selection = projects.slice(0, 6);

// Communities & programs (non-private). Rendered as small tags/chips.
// A chip with `media` becomes a button that opens a click-through modal (same
// native <dialog> pattern as the Experience timeline). Drop files in
// public/images/communities/<slug>/ and list them here.
//
// One ordered `media` array holds photos and video clips together so the modal
// can tell the story in sequence instead of grouping by file type. An entry
// with a `poster` renders as a <video>; everything else renders as an <img>.
// Raw camera files are processed first — see scripts/process-community-media.mjs.
interface CommunityMedia {
  src: string;
  alt: string;
  caption?: string;
  poster?: string; // present => this entry is a video clip
}

interface Community {
  name: string;
  blurb?: string;
  media?: CommunityMedia[];
}

