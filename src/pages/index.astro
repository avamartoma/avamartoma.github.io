---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Experience from '../components/Experience.astro';
import NowPlaying from '../components/NowPlaying.astro';
import GitHubActivity from '../components/GitHubActivity.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

// Load projects, drop drafts, newest first.
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Homepage shows a selection; the full, filterable list lives on /work.
const selection = projects.slice(0, 6);

// Communities & programs (non-private). Rendered as small tags/chips.
// A chip with `media` becomes a button that opens a click-through modal (same
// native <dialog> pattern as the Experience timeline). Drop files in
// public/images/communities/<slug>/ and list them here.
//
// One ordered `media` array holds photos and video clips together so the modal
// can tell the story in sequence instead of grouping by file type. An entry
// with a `poster` renders as a <video>; everything else renders as an <img>.
// Raw camera files are processed first — see scripts/process-community-media.mjs.
interface CommunityMedia {
  src: string;
  alt: string;
  caption?: string;
  poster?: string; // present => this entry is a video clip
}

interface Community {
  name: string;
  blurb?: string;
  media?: CommunityMedia[];
}

const communities: Community[] = [
  { name: 'Amazon Future Engineer' },
  { name: 'LinkedIn Possibilities in Tech' },
  { name: 'Coca-Cola Scholars' },
  { name: 'Chick-fil-A Community Scholars' },
  { name: 'M&T Bank' },
  { name: 'NCWIT Aspirations in Computing' },
  { name: 'Calvin Coolidge Senator' },
  { name: 'MITES' },
  {
    name: 'T-Mobile Changemaker Challenge',
    blurb:
      'KIDSMATES — the nonprofit I co-founded — won a $15,000 grant at the 2023 T-Mobile Changemaker Challenge in Seattle, one of three winning teams from the national cohort.',
    media: [
      { src: '/images/communities/t-mobile-changemaker/changemaker-11.jpg', alt: 'Ava pitching KIDSMATES on stage, with a slide reading “KIDSMATES — Joshua Martoma & Ava Martoma” behind her.', caption: 'Pitching KIDSMATES on stage' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-09.jpg', alt: 'Ava and her brother Joshua accept the oversized $15,000 KIDSMATES check from a T-Mobile Foundation representative.', caption: 'Accepting the $15,000 grant' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-10.jpg', alt: 'The three winning teams on stage, each holding a $15,000 T-Mobile Foundation check.', caption: 'The three 2023 winning teams' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-02.jpg', alt: 'Ava carrying the giant pink $15,000 KIDSMATES check across the T-Mobile campus.', caption: 'One very large check' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-03.jpg', alt: 'The 2023 Changemaker Challenge cohort in matching hoodies in front of a pink “Welcome Changemakers” backdrop.', caption: 'The 2023 cohort' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-04.jpg', alt: 'Ava talking with other participants in front of the pink “Welcome Changemakers” screen.', caption: 'Meeting the other changemakers' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-05.jpg', alt: 'Ava and her reflection group posing at a rope-net structure.', caption: 'Reflection group' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-07.jpg', alt: 'The cohort laughing together beneath the Space Needle.', caption: 'Seattle Center' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-08.jpg', alt: 'The full cohort seated together on wide wooden steps.', caption: 'The whole crew' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-01.jpg', alt: 'Ava and a fellow changemaker in pink T-Mobile rain ponchos taking a selfie in the rain on campus.', caption: 'Rainy day on campus' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-12.jpg', alt: 'Ava and three others on a pink couch beneath a large magenta T-Mobile logo.', caption: 'T-Mobile HQ' },
      { src: '/images/communities/t-mobile-changemaker/changemaker-13.jpg', alt: 'Ava lining up a shot on a pink-felt pool table during downtime.', caption: 'Downtime' },
    ],
  },
  {
    name: 'Taco Bell Ambition Accelerator',
    blurb:
      "The Taco Bell Foundation and Ashoka named KidsMates — the nonprofit I co-founded — one of the Ambition Accelerator's Top 50 semi-finalists. The 2024 summit was two days at Taco Bell's headquarters in Irvine: showcasing our work on resilience and STEM access for children of incarcerated parents, team challenges with the rest of the cohort, and a certificate for fueling a movement of changemakers.",
    media: [
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-03.jpg',
        alt: 'Ava standing behind her KidsMates table at the Ambition Accelerator Summit, a laptop in front of her showing a slide titled “Developing Resilience in the Face of Parental Incarceration”, with a large Taco Bell Foundation and Ashoka summit board describing KidsMates behind her.',
        caption: 'Showcasing KidsMates at the summit',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-video-02.mp4',
        poster: '/images/communities/taco-bell-ambition-accelerator/taco-bell-video-02-poster.jpg',
        alt: 'Video clip: the summit screen reads “Ava Martoma — KidsMates” as Ava is called up, then she stands on the lit stage holding her Ambition Accelerator certificate.',
        caption: 'Called up on stage (video)',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-04.jpg',
        alt: 'Ava on the summit stage holding her purple Ambition Accelerator certificate, which reads “In honor of your achievement in fueling a movement of changemakers in your community — Ava Martoma, KidsMates”.',
        caption: 'The Ambition Accelerator certificate',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-08.jpg',
        alt: 'A wall-sized backlit display in the hotel lobby showing a grid of fifty headshots with a hand-drawn “50” across it, captioned “Ambition Accelerator Top 50”.',
        caption: 'The Top 50 wall',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-10.jpg',
        alt: 'Purple graphic with the KidsMates logo reading “Taco Bell x Ashoka — Ambition Accelerator Semi-Finalist”, with a cartoon taco mascot.',
        caption: 'Semi-finalist announcement',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-09.jpg',
        alt: 'Participants in black “Spark Positive Change” T-shirts walking toward the glass doors of Taco Bell headquarters, the entrance lettered “1 Glen Bell Way”.',
        caption: 'Heading in — 1 Glen Bell Way',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-01.jpg',
        alt: 'The full Ambition Accelerator cohort of about fifty people in matching black T-shirts and purple lanyards, posed outside the glass entrance of Taco Bell headquarters.',
        caption: 'The cohort at Taco Bell HQ',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-02.jpg',
        alt: 'A dozen participants laughing in a conference room around a collapsed tower of spaghetti and marshmallows on the floor, taco artwork on the wall behind them.',
        caption: 'Our tower did not survive the build challenge',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-video-01.mp4',
        poster: '/images/communities/taco-bell-ambition-accelerator/taco-bell-video-01-poster.jpg',
        alt: 'Video clip: Ava steps up to an oversized Taco Bell Foundation prize wheel set up on turf outside and waits while a staff member resets it for her turn.',
        caption: 'Taking a turn at the prize wheel (video)',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-06.jpg',
        alt: 'The cohort in purple Taco Bell Foundation jerseys posed in front of the Disneyland Railroad station and the Mickey Mouse flower bed.',
        caption: 'Cohort day out at Disneyland',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-07.jpg',
        alt: 'Ava in a purple Ambition Accelerator jersey standing on the tram tracks on Main Street, U.S.A., with Sleeping Beauty Castle in the distance.',
        caption: 'Main Street, U.S.A.',
      },
      {
        src: '/images/communities/taco-bell-ambition-accelerator/taco-bell-05.jpg',
        alt: 'Participants in purple jerseys gathered under Pixar Fest banners at the entrance to Disney California Adventure.',
        caption: 'Outside Disney California Adventure',
      },
    ],
  },
  { name: 'Davidson Young Scholars' },
];
---

<Layout>
  <Hero count={projects.length} />

  <!-- ============ WORK ============ -->
  <section class="section" id="work">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2>Selected work</h2>
        <p class="label">{projects.length} project{projects.length === 1 ? '' : 's'} — a curated mess</p>
      </header>

      {projects.length === 0 ? (
        <p class="empty">
          No projects yet. Add a Markdown file to
          <code>src/content/projects/</code> and it shows up here.
        </p>
      ) : (
        <>
          <div class="proj-list">
            {selection.map((p, i) => (
              <ProjectRow
                href={`${base}projects/${p.id}/`}
                title={p.data.title}
                blurb={p.data.blurb}
                tags={p.data.tags}
                date={p.data.date}
                accent={p.data.accent}
                accentAlt={p.data.accentAlt}
                index={i}
              />
            ))}
          </div>

          {projects.length > selection.length && (
            <div class="work-more" data-reveal>
              <a href={`${base}work/`} class="btn btn--solid">
                See all {projects.length} projects →
              </a>
            </div>
          )}
        </>
      )}
    </div>
  </section>

  <hr class="divider" />

  <!-- ============ LATELY ============ -->
  <section class="section" id="lately">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2>Lately</h2>
        <p class="label">What I'm listening to &amp; building</p>
      </header>
      <div class="lately__grid" data-reveal>
        <NowPlaying />
        <GitHubActivity />
      </div>
    </div>
  </section>

  <hr class="divider" />

  <Experience />

  <hr class="divider" />

  <!-- ============ COMMUNITIES ============ -->
  <section class="section" id="recognition">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2>Communities</h2>
        <p class="label">Programs, scholarships &amp; fellowships</p>
      </header>
      <ul class="community-tags" data-reveal>
        {communities.map((c, i) => {
          const style = `--tag-accent: var(--signal${i % 5 === 0 ? '' : '-' + ((i % 5) + 1)});`;
          return (
            <li class="community-tags__item" style={style}>
              {c.media && c.media.length > 0 ? (
                <button
                  type="button"
                  class="community-tag community-tag--photos"
                  data-comm-open={i}
                  aria-haspopup="dialog"
                >
                  {c.name}
                  <span class="community-tag__badge" aria-hidden="true">◈ {c.media.length}</span>
                </button>
              ) : (
                <span class="community-tag">{c.name}</span>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {/* Click-through photo/video modals for communities that have media. Native
      <dialog> gives us Escape-to-close, backdrop, and focus handling free. */}
  {communities.map((c, i) =>
    c.media && c.media.length > 0 ? (
      <dialog class="comm__dialog" id={`comm-dialog-${i}`} aria-label={`${c.name} — photos`}>
        {/* The close button is a direct child of the dialog, NOT of the
            scrolling inner div — it is positioned against the dialog, and
            nesting it inside the scroll container makes hit-testing and
            scroll-into-view fight over an element that never moves. */}
        <button class="comm__dialog-close" type="button" aria-label="Close" data-comm-close>×</button>
        <div class="comm__dialog-inner">
          <h3 class="comm__dialog-title">{c.name}</h3>
          {c.blurb && <p class="comm__dialog-blurb">{c.blurb}</p>}
          <div class="comm__dialog-photos">
            {c.media.map((m) => (
              <figure class="comm__photo">
                {m.poster ? (
                  /* preload="none" so a modal full of clips costs nothing until
                     played; playsinline keeps iOS from hijacking to fullscreen. */
                  <video
                    class="comm__video"
                    src={m.src}
                    poster={m.poster}
                    controls
                    preload="none"
                    playsinline
                    aria-label={m.alt}
                  >
                    <a href={m.src}>Download the video</a>
                  </video>
                ) : (
                  <img src={m.src} alt={m.alt} loading="lazy" />
                )}
                {m.caption && <figcaption>{m.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </dialog>
    ) : null,
  )}
</Layout>

<style>
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .work-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  /* Lately: Now Playing + GitHub activity. auto-fit keeps it tidy whether one
     card (Spotify not connected yet) or two are present. */
  .lately__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--gap);
    align-items: start;
  }

  .proj-list { display: flex; flex-direction: column; }

  .empty {
    color: var(--ink-soft);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .empty code {
    color: var(--signal);
    font-family: var(--font-mono);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about__lead { margin-top: 0.75rem; }
  .about__hi {
    color: var(--signal);
  }
  .about__photo {
    margin-top: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 360px;
    aspect-ratio: 5 / 6;
  }
  .about__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.95) contrast(1.02);
    transition: transform 0.6s var(--ease);
  }
  .about__photo:hover img { transform: scale(1.03); }
  .about__col p { margin-bottom: 1.25rem; color: var(--ink-soft); }

  .stack { margin-top: 2rem; }
  .stack__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 0.75rem;
  }
  .stack__list li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.4em 0.8em;
    color: var(--ink);
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .stack__list li:hover { border-color: var(--signal); color: var(--signal); }

  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; }
  }

  /* credential line + bio extras */
  .about__cred {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-top: 1rem;
    max-width: 40ch;
  }
  .about__col strong { color: var(--ink); font-weight: 500; }
  .about__play { color: var(--ink); }
  .about__edu { color: var(--ink-soft); font-size: 0.92rem; margin-top: 0.5rem; }
  .about__edu span { color: var(--muted); }

  /* Communities — small tags that light up in site colors. Chips with photos
     become buttons that open a click-through modal. */
  .community-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .community-tags__item { display: flex; }
  .community-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5em 1em;
    cursor: pointer;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease),
      background 0.25s var(--ease), box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .community-tag:hover {
    color: var(--tag-accent);
    border-color: var(--tag-accent);
    background: color-mix(in srgb, var(--tag-accent) 12%, transparent);
    box-shadow: 0 0 0 1px var(--tag-accent),
      0 6px 20px color-mix(in srgb, var(--tag-accent) 30%, transparent);
    transform: translateY(-2px);
  }
  /* photo chips are buttons — reset the UA styling and focus ring */
  button.community-tag { font: inherit; font-size: 0.8rem; }
  .community-tag--photos:focus-visible {
    outline: none;
    color: var(--tag-accent);
    border-color: var(--tag-accent);
    box-shadow: 0 0 0 2px var(--tag-accent);
  }
  .community-tag__badge {
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: var(--tag-accent);
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: reduce) {
    .community-tag { transition: none; }
    .community-tag:hover { transform: none; }
  }

  /* ===== Community photo modal (mirrors the Experience dialog) ===== */
  .comm__dialog {
    max-width: min(94vw, 860px);
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    padding: 0;
    margin: auto;
    /* MUST be `fixed`, for two reasons:
       1. It anchors the open dialog to the viewport. The UA gives a modal
          dialog `inset: 0`, so a document-anchored dialog sits at the top of
          the PAGE and the browser scrolls the whole page up to reveal it —
          which reads as "clicking a chip jumps me to the top".
       2. It creates the containing block for the × button, so the button stays
          pinned to the corner instead of scrolling away with the media list.
       Do NOT use `relative` here: elements in the top layer have `static` and
       `relative` coerced to `absolute`, which reintroduces the scroll jump. */
    position: fixed;
  }
  .comm__dialog::backdrop {
    background: rgba(5, 5, 8, 0.66);
    backdrop-filter: blur(3px);
  }
  .comm__dialog-inner {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    max-height: 88vh;
    overflow-y: auto;
  }
  .comm__dialog-close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    z-index: 2; /* above the scrolling media grid */
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .comm__dialog-close:hover { border-color: var(--signal); color: var(--signal); }
  .comm__dialog-title { font-size: 1.4rem; line-height: 1.15; margin-bottom: 0.4rem; padding-right: 2rem; }
  .comm__dialog-blurb {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin-bottom: 1.4rem;
    max-width: 60ch;
  }
  .comm__dialog-photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0.75rem;
  }
  .comm__photo { margin: 0; }
  .comm__photo img,
  .comm__photo .comm__video {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius) * 0.6);
    border: 1px solid var(--line);
    display: block;
  }
  /* Photos fill the tile; a little cropping is fine. Clips are letterboxed
     instead — these are portrait phone videos, and a 4/3 cover crop would cut
     the subject out of frame entirely. */
  .comm__photo img { object-fit: cover; }
  .comm__photo .comm__video {
    object-fit: contain;
    background: #000;
  }
  .comm__photo figcaption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
    margin-top: 0.4rem;
    line-height: 1.35;
  }
</style>

<script>
  // Community photo/video modals. A chip with media opens its <dialog>; close on
  // the × button, on Escape (native), or by clicking the backdrop.
  document.querySelectorAll<HTMLButtonElement>('[data-comm-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const i = btn.getAttribute('data-comm-open');
      const dialog = document.getElementById(`comm-dialog-${i}`) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('.comm__dialog').forEach((dialog) => {
    dialog.querySelector('[data-comm-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Closing hides the dialog but does NOT stop playback, so a clip would keep
    // playing audio over an apparently-dismissed modal. Pause on every close
    // path (×, backdrop, Escape) — 'close' fires for all three.
    dialog.addEventListener('close', () => {
      dialog.querySelectorAll('video').forEach((v) => v.pause());
    });
  });
</script>
