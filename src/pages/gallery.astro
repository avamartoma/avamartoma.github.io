---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

// ---------------------------------------------------------------------------
// Gallery items. Each photo links somewhere: a project, an experience, a
// community, or a personal page.
//
//   photo('/images/gallery/file.jpg', 'alt text', href, 'Label')
//
// Rows alternate scroll direction (row 1 →, row 2 ←, …). Hover a photo to
// pause the row and reveal its label. `href` uses the helpers below.
//
// To add more: drop gal-NN.jpg in public/images/gallery/, LOOK at it, then add
// a photo(...) entry to a row with a short label + accurate alt + a destination.
// A chat can only hold ~100 inline images, so caption large batches in their own
// session (see the red block at the top of HANDOVER.md).
// ---------------------------------------------------------------------------

type Item = { kind: 'photo'; src: string; alt: string; href: string; label: string };

const photo = (src: string, alt: string, href: string, label: string): Item => ({
  kind: 'photo', src, alt, href, label,
});

// Destinations reused below.
const P = (slug: string) => `${base}projects/${slug}/`;
const EXP = `${base}#experience`;
const COMM = `${base}#recognition`; // the Communities section (chips open modals)
const HOME = base; // personal / about — until a dedicated /living page exists

// ---------------------------------------------------------------------------
// All 60 processed gal-NN.jpg were viewed and captioned; 38 of the strongest
// are wired below (dropped near-duplicates + a few dark/ambiguous frames). The
// four cover-*.jpg from the Wix portfolio anchor the first four rows.
//
// Eight destinations were CERTAIN — those files are byte-identical to photos in
// other sets (found with md5sum), so their targets weren't re-derived:
//   gal-14 = pgn-04    → COMM  (Phi Gamma Nu)
//   gal-17 = pgn-06    → COMM  (Phi Gamma Nu)
//   gal-18 = lpit-08   → COMM  (LinkedIn Possibilities in Tech)
//   gal-41 = cfa-05    → COMM  (Chick-fil-A Community Scholars)
//   gal-42 = cfa-07    → COMM  (Chick-fil-A Community Scholars)
//   gal-49 = afenew-01 → P('afe-hackathon')
//   gal-52 = cfa-25    → COMM  (Chick-fil-A Community Scholars)
//   gal-53 = cfa-26    → COMM  (Chick-fil-A Community Scholars)
// (gal-14 and gal-17 were held back while the Phi Gamma Nu chip was still an
// inert span. The chip became a live modal in pt.8b and both photos are
// published in it, so they were wired in on 2026-08-06 — md5 re-checked.)
//
// Re-run this to spot overlap in any future batch:
//   find public/images -name '*.jpg' | xargs md5sum | sort | uniq -w32 -D
// ---------------------------------------------------------------------------

// One loop time for every row — the only difference between rows is direction.
// Raise this single number to slow the whole wall down.
const MARQUEE_DURATION = '160s';

// 5 rows, alternating direction.
const rows: { dir: 'left' | 'right'; items: Item[] }[] = [
  {
    dir: 'left', items: [
      photo('/images/gallery/cover-architecture.jpg', 'Ava presenting her architecture site-analysis project', P('architecture'), 'Architecture'),
      photo('/images/gallery/gal-01.jpg', 'Ava holding a squash trophy on a glass court', EXP, 'Squash trophy'),
      photo('/images/gallery/gal-02.jpg', 'Ava and a friend showing off watercolor paintings at an outdoor paint session', HOME, 'Watercolors'),
      photo('/images/gallery/gal-08.jpg', 'Ava with the MITES cohort on the steps at MIT', COMM, 'MITES'),
      photo('/images/gallery/gal-17.jpg', 'Ava and her Phi Gamma Nu chapter on the floor of a wood-panelled hall holding hand-made posters cheering for members performing in a dance showcase', COMM, 'Phi Gamma Nu'),
      photo('/images/gallery/gal-21.jpg', 'Ava skiing at the top of a run above a frozen lake', HOME, 'Skiing'),
      photo('/images/gallery/gal-38.jpg', 'Ava with her Penn squash teammates under the Penn "P"', EXP, 'Penn squash'),
      photo('/images/gallery/gal-49.jpg', 'Ava and fellow Amazon interns at the Spheres', P('afe-hackathon'), 'Amazon Path'),
      photo('/images/gallery/gal-33.jpg', 'Ava with friends on the beach at golden hour', HOME, 'Beach friends'),
    ],
  },
  {
    dir: 'right', items: [
      photo('/images/gallery/cover-woodshop.jpg', 'Ava at the drill press in the wood shop', P('cad-projects'), 'Wood shop'),
      photo('/images/gallery/gal-41.jpg', 'Chick-fil-A Community Scholars celebrating a $25,000 award with the Chick-fil-A cow and confetti', COMM, 'Chick-fil-A Scholars'),
      photo('/images/gallery/gal-19.jpg', 'Ava bouldering on an indoor climbing wall', HOME, 'Bouldering'),
      photo('/images/gallery/gal-27.jpg', 'Ava mid-swing during a squash match', EXP, 'On court'),
      photo('/images/gallery/gal-11.jpg', 'Ava and friends on a rooftop overlooking the São Paulo skyline', HOME, 'São Paulo'),
      photo('/images/gallery/gal-18.jpg', 'Studio portrait of Ava, taken for LinkedIn Possibilities in Tech', COMM, 'LinkedIn PiT'),
      photo('/images/gallery/gal-59.jpg', 'Ava at a squash tournament venue', EXP, 'Tournament'),
      photo('/images/gallery/gal-20.jpg', 'A strawberry layer cake Ava baked', HOME, 'Baking'),
    ],
  },
  {
    dir: 'left', items: [
      photo('/images/gallery/cover-changemaker.jpg', 'Ava at the T-Mobile Changemaker Challenge', COMM, 'Changemaker'),
      photo('/images/gallery/gal-09.jpg', 'Studio squash portrait of Ava with her racket', EXP, 'Squash'),
      photo('/images/gallery/gal-04.jpg', 'Ava and a friend at a Joy Crookes concert', HOME, 'Concert'),
      photo('/images/gallery/gal-52.jpg', 'Ava holding an Oscar statuette at the Walt Disney Archives during the Chick-fil-A scholars trip', COMM, 'Disney Archives'),
      photo('/images/gallery/gal-30.jpg', 'Ava on the Penn campus steps under magnolia blossoms', HOME, 'Penn in spring'),
      photo('/images/gallery/gal-57.jpg', 'Overhead view of Ava\'s squash team lining up before a match at Penn', EXP, 'Match day'),
      photo('/images/gallery/gal-31.jpg', 'Ava at a hands-on "project DIY" craft table', HOME, 'Project DIY'),
      photo('/images/gallery/gal-40.jpg', 'Ava and a friend with a snowman on the Penn quad', HOME, 'Snow day'),
    ],
  },
  {
    dir: 'right', items: [
      photo('/images/gallery/cover-beach.jpg', 'Ava on the beach at sunset', HOME, 'Off the clock'),
      photo('/images/gallery/gal-23.jpg', 'Ava and squash teammates holding handmade senior-day posters', EXP, 'Senior day'),
      photo('/images/gallery/gal-42.jpg', 'Ava and fellow scholars at the Chick-fil-A Backstage Tour', COMM, 'CFA Backstage'),
      photo('/images/gallery/gal-06.jpg', 'Ava lining up a shot on a pool table in a white dress', HOME, 'Pool'),
      photo('/images/gallery/gal-39.jpg', 'Ava shaking hands after a squash match', EXP, 'Match point'),
      photo('/images/gallery/gal-25.jpg', 'Ava under a blooming crape myrtle in summer', HOME, 'Summer bloom'),
      photo('/images/gallery/gal-47.jpg', 'Paddleboarding on a lake at dusk in Seattle', HOME, 'Paddleboard'),
      photo('/images/gallery/gal-53.jpg', 'Chick-fil-A Community Scholars on a trip to Cars Land', COMM, 'CFA Scholars'),
    ],
  },
  {
    dir: 'left', items: [
      photo('/images/gallery/gal-07.jpg', 'Ava with a group of Penn friends', HOME, 'Penn friends'),
      photo('/images/gallery/gal-58.jpg', 'Ava\'s Penn squash team celebrating in a high-five line', EXP, 'Team spirit'),
      photo('/images/gallery/gal-48.jpg', 'Ava hiking a foggy trail in an Amazon Future Engineer hoodie', COMM, 'Amazon Future Engineer'),
      photo('/images/gallery/gal-14.jpg', 'Ava and her Phi Gamma Nu chapter holding marshmallow skewers outside a string-lit A-frame house at night, a fire pit burning to one side', COMM, 'Chapter retreat'),
      photo('/images/gallery/gal-29.jpg', 'Ava and friends at the start of a road race', HOME, 'Race day'),
      photo('/images/gallery/gal-32.jpg', 'Ava in a blazer for a professional headshot on campus', EXP, 'Suited up'),
      photo('/images/gallery/gal-37.jpg', 'Ava and a friend on the beach at sunset', HOME, 'Sunset beach'),
      photo('/images/gallery/gal-54.jpg', 'Ava tasting fresh whipped cream in a pastry class', HOME, 'Pastry class'),
      photo('/images/gallery/gal-35.jpg', 'Ava with family at a birthday dinner', HOME, 'Family'),
    ],
  },
];
---

<Layout
  title="Gallery — Ava Martoma"
  description="A wall of photos from Ava Martoma's projects, work, and life — click through to the story behind each one."
>
  <section class="section gallery">
    <div class="wrap">
      <header class="gallery__head" data-reveal>
        <h1>Gallery</h1>
        <p class="label">
          A wall of moments — projects, work, and life. Hover to pause a row;
          click any photo to jump to its story.
        </p>
      </header>
    </div>

    <!-- Full-bleed marquee rows; each row scrolls on its own, alternating -->
    <div class="marquee-rows" data-reveal>
      {rows.map((row) => (
        <div class="marquee" data-dir={row.dir} style={`--dur:${MARQUEE_DURATION}`}>
          <ul class="marquee__track">
            {[...row.items, ...row.items].map((item, i) => (
              <li class="marquee__cell" aria-hidden={i >= row.items.length ? 'true' : undefined}>
                <a
                  class="g-item"
                  href={item.href}
                  tabindex={i >= row.items.length ? -1 : undefined}
                >
                  <img src={`${base.replace(/\/$/, '')}${item.src}`} alt={item.alt} loading="lazy" />
                  <span class="g-item__cap">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .gallery { overflow: clip; }
  /* Headings globally use line-height 1.02, which is tighter than the font's
     ascender+descender, so a descender (the "y" in Gallery) hangs BELOW its own
     line box. With no gap, it collided with the label text underneath. The
     margin is in em so it tracks the clamp()ed font size instead of only being
     right at one viewport width. */
  .gallery__head h1 { margin-bottom: 0.25em; }
  .gallery__head { margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }

  .marquee-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.5vw, 1rem);
  }

  .marquee {
    position: relative;
    overflow: hidden;
    /* soft fade at both edges so photos scroll in/out gracefully */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: clamp(0.6rem, 1.5vw, 1rem);
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
    animation: marquee var(--dur, 80s) linear infinite;
  }
  /* right-moving rows just run the same loop in reverse */
  .marquee[data-dir='right'] .marquee__track { animation-direction: reverse; }

  /* pause the row while hovering so it's easy to aim + click */
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  .marquee__cell { flex: 0 0 auto; }

  .g-item {
    --row-h: clamp(120px, 15vw, 190px);
    position: relative;
    display: block;
    height: var(--row-h);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface, #17151b);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .g-item img {
    display: block;
    height: 100%;
    width: auto;
    object-fit: cover;
  }

  .g-item:hover,
  .g-item:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px -12px rgba(0,0,0,0.6);
    outline: none;
  }

  /* label chip — hidden until hover/focus for a cleaner wall */
  .g-item__cap {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    padding: 0.3em 0.55em;
    border-radius: 7px;
    background: color-mix(in srgb, var(--bg) 62%, transparent);
    backdrop-filter: blur(4px);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* on real photos, keep the chip hidden until hover/focus for a cleaner wall */
  .g-item:has(img) .g-item__cap {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .g-item:has(img):hover .g-item__cap,
  .g-item:has(img):focus-visible .g-item__cap {
    opacity: 1;
    transform: none;
  }

  /* Motion off: no auto-scroll — let people scroll each row by hand instead. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; scrollbar-width: thin; }
    .marquee__track { animation: none; }
    /* the duplicated set is redundant without motion, but harmless */
  }
</style>
